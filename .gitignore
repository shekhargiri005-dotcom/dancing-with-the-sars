# ==============================================================================
# Git Ignore Rules — Dancing with the SARs
# ==============================================================================

# Database files & schemas
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
*.sql
*.schema
*.dump
schema/
migrations/
database/
db/

# Scratch & development test scripts
scratch/
temp/
tmp/
*.tmp

# Environment variables & credentials
.env
.env.*
!.env.example
credentials.json
client_secret*.json
*.token
*.secret
*.pem
*.key
*.cert
*.pfx
*.p12

# Python & Jupyter artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.ipynb_checkpoints/

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System & Editor artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Logs
*.log
logs/
